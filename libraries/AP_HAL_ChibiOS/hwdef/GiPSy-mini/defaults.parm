#https://ardupilot.org/rover/docs/parameters-Rover-stable-V4.5.7.html
ACRO_TURN_RATE 120
ARMING_CHECK 0
ARMING_RUDDER 0
ATC_ACCEL_MAX 0.6
ATC_DECEL_MAX 0.4
ATC_SPEED_I 0.1
ATC_SPEED_P 0.1
ATC_STR_ACC_MAX 30
ATC_STR_ANG_P 1
ATC_STR_RAT_FF 0.18
ATC_STR_RAT_I 0.001
ATC_STR_RAT_MAX 200
ATC_TURN_MAX_G 0.3
BATT_MONITOR 3
BATT_VOLT_MULT 11.00294
BATT2_MONITOR 9
COMPASS_AUTO_ROT 0 #IMO need to be set to 2 "CheckAutoRotation and fix"
COMPASS_CAL_FIT 32
COMPASS_EXTERN2 1
COMPASS_EXTERNAL 1
COMPASS_ORIENT 6 #YAW270
COMPASS_ORIENT2 6 #YAW270
COMPASS_USE3 0
CRUISE_SPEED 0.9
CRUISE_THROTTLE 75
FRAME_CLASS 2 #BOAT
FS_THR_ENABLE 0 #Throttle Failsafe disabled
GCS_PID_MASK 1
GPS_AUTO_SWITCH 1 #GPS Automatic Switchover Setting, use BEST 
GPS_NAVFILTER 5 #set filter to SEA 
GPS_TYPE 1
GPS_TYPE2 1
INITIAL_MODE 4 #Initial Mode Hold
INS_ACC_BODYFIX 1 #use 1st imu
INS_GYRO_RATE 0 #gyro rate 1 khz
LOG_FILE_BUFSIZE 16
MOT_PWM_TYPE 6 #dshot300
LOIT_RADIUS 1 #Vehicle will drift when within 1 mt 
LOIT_TYPE 1 #Always face bow towards target point
MIS_DONE_BEHAVE 1 #Loiter after mission completes
MOT_THR_MAX 75 #max throttle set to 75
MOT_THR_MIN 0 #min throttle set to 0
RTL_SPEED 1 #Return-to-Launch speed 1m/s
SERIAL1_BAUD 921
SERIAL1_PROTOCOL 2 #mavlink2 on SERIAL1 for telemetry/rpi
SERIAL2_BAUD 38
SERIAL2_PROTOCOL 5 #GPS1 on SERIAL2
SERIAL3_BAUD 38
SERIAL3_PROTOCOL 5 #GPS2 on SERIAL3
SERIAL4_BAUD 115
SERIAL4_PROTOCOL 16 #ESCTELEM on SERIAL4
SERIAL7_BAUD 57
SERIAL7_PROTOCOL 2 #Radio telemetry module on SERIAL7
SERVO_BLH_3DMASK 5 
SERVO_BLH_AUTO 1 #enable BLHeli Passthrough for ESC configuration 
SERVO_BLH_MASK 5 
SERVO1_FUNCTION 73 #ThrottleLeft
SERVO1_MAX 1750
SERVO1_MIN 1250
SERVO1_REVERSED 1 #reversed
SERVO3_FUNCTION 74 #ThrottleRight
SERVO3_MAX 1750
SERVO3_MIN 1250
SERVO3_REVERSED 1 #reversed
SR0_ADSB 4
SR0_RAW_CTRL 4
SR1_ADSB 4
SR1_EXT_STAT 4
SR1_EXTRA1 4
SR1_EXTRA2 4
SR1_EXTRA3 4
SR1_POSITION 4
SR1_RAW_CTRL 4
SR1_RAW_SENS 4
SR1_RC_CHAN 4
SR2_ADSB 4
SR2_EXT_STAT 4
SR2_EXTRA1 4
SR2_EXTRA2 4
SR2_EXTRA3 4
SR2_POSITION 4
SR2_RAW_CTRL 4
SR2_RAW_SENS 4
SR2_RC_CHAN 4
TURN_RADIUS 1
WP_PIVOT_ANGLE 30
WP_PIVOT_RATE 50
WP_RADIUS 1
WP_SPEED 1
